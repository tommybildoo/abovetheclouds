# ============================================================
# AboveTheClouds V3 — environment variables
# Copy to .env for local dev (wrangler pages dev --local reads this),
# and set the same names as Cloudflare Pages secrets/vars for production:
#   wrangler pages secret put NAME
# ============================================================

# ---- Flight data provider ----
# "demo" (default, no credentials needed) or "opensky"
FLIGHT_DATA_PROVIDER=demo

# Only required if FLIGHT_DATA_PROVIDER=opensky
FLIGHT_API_BASE_URL=https://opensky-network.org/api
FLIGHT_API_CLIENT_ID=
FLIGHT_API_CLIENT_SECRET=
# Some providers use a simple API key instead of OAuth client credentials —
# supported for future providers, unused by the OpenSky implementation:
FLIGHT_API_KEY=

# ---- Aircraft metadata provider (OPTIONAL — not integrated yet) ----
# OpenSky's live position feed does NOT include aircraft type,
# registration, airline, origin, or destination. Those fields stay
# "Unknown" / "—" in the UI unless a metadata provider is configured
# here. No provider is wired up by default — see
# server/lib/metadataProviders/index.js for how to add one when you're
# ready (e.g. a paid schedule/registration lookup API).
AIRCRAFT_METADATA_PROVIDER=none
AIRCRAFT_METADATA_API_KEY=
AIRCRAFT_METADATA_BASE_URL=

# ---- Admin panel ----
# Shared secret required in the X-Admin-Token header to call /api/admin/*.
# Generate a long random value, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# ---- Site ----
PUBLIC_SITE_URL=https://abovetheclouds.club
