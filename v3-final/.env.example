# ============================================================
# AboveTheClouds V3 — environment variables
# Copy to .env for local dev, and set the same names as
# Cloudflare Pages vars/secrets for production.
# ============================================================

# ---- Flight data provider ----
# "opensky" = real live ADS-B data
# "demo" = synthetic fallback for development
FLIGHT_DATA_PROVIDER=opensky
FLIGHT_API_BASE_URL=https://opensky-network.org/api

# OpenSky OAuth2 client credentials.
# Create an API client from your OpenSky account.
# NEVER commit these values.
FLIGHT_API_CLIENT_ID=
FLIGHT_API_CLIENT_SECRET=

# ---- Aircraft metadata provider (OPTIONAL) ----
AIRCRAFT_METADATA_PROVIDER=none
AIRCRAFT_METADATA_API_KEY=
AIRCRAFT_METADATA_BASE_URL=

# ---- Admin panel ----
ADMIN_TOKEN=

# ---- Site ----
PUBLIC_SITE_URL=https://abovetheclouds.club
